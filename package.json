{
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "name": "@insoutt/punku",
  "license": "MIT",
  "version": "1.2.0",
  "description": "Simple React hook form for Laravel",
  "keywords": [
    "laravel",
    "react",
    "form",
    "hook",
    "inertia"
  ],
  "scripts": {
    "dev": "vitest",
    "build": "tsc",
    "ci": "yarn build && yarn check-format && yarn check-exports && yarn test",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "check-exports": "attw --pack . --ignore-rules=cjs-resolves-to-esm",
    "test": "vitest run",
    "local-release": "changeset version && changeset publish",
    "prepublishOnly": "npm run ci"
  },
  "homepage": "https://github.com/insoutt/punku",
  "bugs": {
    "url": "https://github.com/insoutt/punku/issues"
  },
  "author": "insoutt <hi@elvisfernando.com> (https://elvisfernando.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insoutt/punku.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@changesets/cli": "^2.28.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.10",
    "jsdom": "^30.1.2",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "axios": "^1.8.2"
  },
  "peerDependencies": {
    "react": ">=17"
  }
}
